msgid "Enter a valid email address."
msgstr "Escribe una dirección de correo electrónico válida."

#, python-format
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Asegúrate de que este valor tenga como máximo %(limit_value)d carácter "
"(tiene %(show_value)d)."
msgstr[1] ""
"Asegúrate de que este valor tenga como máximo %(limit_value)d caracteres "
