# Traducciones propias del proyecto para español de México.
#
# Corrigen los textos de Django y de django-allauth que se muestran en las pantallas y
# correos del proyecto y no cumplen docs/lineamientos/diseno-de-interfaz.md: los que tratan
# de usted pasan a tú, y se corrigen las mayúsculas en cada palabra, los términos distintos
# para un mismo concepto y los errores de la traducción original. Los textos que ya tratan
# de tú y no tienen otro problema no se incluyen. Tienen prioridad sobre los catálogos de
# las bibliotecas porque el directorio está en LOCALE_PATHS. Cada msgid debe existir tal
# cual en el catálogo de la biblioteca; config/tests.py lo comprueba.
#
# Después de editar este archivo se compila con GNU gettext (en Windows, desde la consola
# Bash de Git con .venv/Scripts/python.exe):
#   python manage.py compilemessages --locale es_MX --ignore ".venv*"
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es_MX\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

