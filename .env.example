# Variables de entorno del proyecto. Para desarrollo se copia este archivo como .env y se
# reemplazan los valores; .env no se versiona. Las variables definidas en el entorno del
# sistema tienen prioridad sobre las de .env.
#
# Los comentarios van en su propia línea: un comentario al final de una línea con valor
# puede quedar como parte del valor.
#
# Los valores secretos se generan con:
#   py -3.14 -c "import secrets; print(secrets.token_urlsafe(50))"     (Windows)
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"      (Linux y macOS)
# Si un valor se escribe a mano y contiene $, # o espacios, va entre comillas simples:
# Docker Compose y Django leen este archivo con reglas distintas.

# --- Django ---

# Clave secreta, generada con el comando anterior.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-generada

# Dominios desde los que se sirve el sitio, separados por comas. Obligatorio en producción.
# En desarrollo se deja vacío: con un valor, Django solo acepta los dominios indicados y
# deja de aceptar localhost y 127.0.0.1.
DJANGO_ALLOWED_HOSTS=

# Nivel de los registros: DEBUG, INFO, WARNING, ERROR o CRITICAL.
DJANGO_LOG_LEVEL=INFO

# Nombre del sitio: encabezado de las páginas, asunto de los correos y nombre que muestran
# las aplicaciones de autenticación.
NOMBRE_SITIO=Sitio

# --- PostgreSQL (lo usan Django y compose.yaml) ---

# POSTGRES_DB, POSTGRES_USER y POSTGRES_PASSWORD se aplican al crear el volumen de datos
# del contenedor; para cambiarlos después se ejecuta docker compose down -v, que borra los
# datos. POSTGRES_PORT es el puerto del equipo en el que se publica PostgreSQL: si otro
# proyecto ya usa el 5432, se elige otro y se ejecuta docker compose up -d.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=reemplazar-por-una-contrasena-generada
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Cuentas de usuario ---

# true permite que cualquier persona cree una cuenta desde la página de registro. Con
# false, las cuentas las crea el personal desde el sitio de administración.
CUENTAS_REGISTRO_ABIERTO=false

# Verificación del correo: obligatoria (no se inicia sesión sin confirmar el enlace que
# llega por correo), opcional (se envía el enlace, pero no se exige) o ninguna. Con el
# registro abierto, solo obligatoria evita que la página de registro revele qué
# direcciones ya tienen cuenta.
CUENTAS_VERIFICACION_CORREO=obligatoria

# true permite que cada persona active la autenticación de dos factores, con una
# aplicación de autenticación y códigos de recuperación.
CUENTAS_DOBLE_FACTOR_ACTIVO=true

# true exige la autenticación de dos factores para entrar al sitio de administración.
# Requiere CUENTAS_DOBLE_FACTOR_ACTIVO=true.
CUENTAS_ADMINISTRACION_EXIGE_DOBLE_FACTOR=true

# true permite registrar llaves de acceso (passkeys) e iniciar sesión con ellas. Requieren
# HTTPS; en desarrollo funcionan en http://localhost:8000, no en 127.0.0.1. Requiere
# CUENTAS_DOBLE_FACTOR_ACTIVO=true.
CUENTAS_LLAVES_ACCESO_ACTIVAS=false

# Número de proxies inversos propios delante de la aplicación, para conocer la dirección
# IP real en los límites de intentos: 0 si la aplicación recibe las conexiones
# directamente, 1 detrás de un nginx que agrega X-Forwarded-For. Solo si la aplicación
# no es accesible sin pasar por esos proxies y el número coincide con los que agregan
# X-Forwarded-For; si llegan menos entradas, la petición falla.
CUENTAS_PROXIES_DE_CONFIANZA=0

# Encabezado con la dirección IP del cliente, por ejemplo X-Real-IP. Solo si el proxy lo
# define siempre y la aplicación no es accesible sin pasar por él. Vacío para no usarlo.
CUENTAS_ENCABEZADO_IP_CLIENTE=

# --- Solo producción (config.settings.prod) ---
#
# En desarrollo los correos no se envían: se muestran en la consola del servidor.

# Remitente de los correos del sitio, por ejemplo no-responder@example.com. Obligatorio.
DJANGO_DEFAULT_FROM_EMAIL=

# Remitente de los avisos de errores del servidor. Vacío para usar el anterior.
DJANGO_SERVER_EMAIL=

# Direcciones que reciben los avisos de errores del servidor, separadas por comas.
DJANGO_ADMINS=

# Servidor SMTP de salida. Obligatorio.
DJANGO_SMTP_HOST=

# Puerto del servidor SMTP.
DJANGO_SMTP_PORT=587

# Usuario y contraseña del servidor SMTP, si los requiere.
DJANGO_SMTP_USERNAME=
DJANGO_SMTP_PASSWORD=

# true para cifrar la conexión con STARTTLS.
DJANGO_SMTP_USE_TLS=true

# Orígenes adicionales de confianza para CSRF, con esquema, separados por comas.
# Ejemplo: https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Duración de HSTS en segundos. Se sube a 31536000 cuando todo el dominio funciona por
# HTTPS.
DJANGO_SECURE_HSTS_SECONDS=3600

# true solo detrás de un proxy inverso que termina HTTPS y reemplaza siempre el
# encabezado X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Segundos que se reutiliza una conexión a la base de datos. Si la aplicación se sirve con
# config/asgi.py se deja en 0, porque las conexiones persistentes no se usan con ASGI.
DJANGO_CONN_MAX_AGE=60
